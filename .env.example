# Virtual Herbal Garden - Environment Configuration Template
# Copy this file to code/backend/.env or configure in your deployment platform (e.g. Netlify/Vercel/Render)
# DO NOT COMMIT REAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL

# Server Port
PORT=3000

# Environment Mode (development | production)
NODE_ENV=development

# Google Gemini Generative AI API Key (for Herbal Garden AI Chatbot Assistant)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative aliases supported by chatbot function:
# GENERATIVE_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: MongoDB Atlas Connection String (for persistent user auth and inquiries)
# If omitted, the backend gracefully utilizes an in-memory datastore.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/herbal_garden?retryWrites=true&w=majority
